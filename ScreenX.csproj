<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <Copyright>Copyright (C) 2026 Brandon Doster</Copyright>

    <!-- Every coordinate is a physical pixel: monitors, windows, the capture and
         the overlay. Nothing scales anything, so mixed-DPI desktops line up. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- Idle is the point. Workstation GC with no background thread, and no ICU
         or resource strings loaded for a program that shows almost no text. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>

    <!-- Precompiled, so the first capture after launch is not paying for JIT. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tests are their own project, beside this one rather than in it. -->
    <Compile Remove="tests/**" />
    <InternalsVisibleTo Include="ScreenX.Tests" />
  </ItemGroup>

</Project>
